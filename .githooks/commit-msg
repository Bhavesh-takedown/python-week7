#!/usr/bin/env sh
set -eu

message_file=$1
first_line=$(sed -n '1p' "$message_file")
pattern='^(feat|fix|docs|style|refactor|test|chore|ci|build|perf)(\([^)]+\))?!?: .+'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message must follow Conventional Commits, for example: feat: add release notes" >&2
  exit 1
fi
